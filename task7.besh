#!bin/bash
#purpose : task on calculator using bash script 
#date : 19-10-2026

echo "Enter the first number"
read num1

echo "Enter the second number"
read num2

echo "select the oparetions (+, -, *, /):"
read op

case $op in 
+)
result=$((num1 +num2 ))
;;

-)
result=$((num1 - num2)) 
;;

\*)
result=$((num1 * num2))
;;

/)
if [ $num2 -eq 0 ]; then
echo "Error : Division by zero is not allowed"
exit 1
fi
result=$((num1 / num2))
;;
*)
echo "Invalid oparetion selected!"
exit1
;;
esac

echo "Result: $result"
